PORT=4001
NODE_ENV=development
SERVICE_NAME=auth-service
ALLOWED_ORIGINS=http://localhost:3000

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=auth_svc
DB_PASSWORD=
DB_POOL_MAX=10

JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Firebase Admin SDK — required for push-notification delivery via
# @samudrayan/shared-firebase's createNotification()/sendPush(). Leave blank
# to boot the service anyway (Firebase init is lazy); notifications still get
# created in the DB, push delivery is just skipped/logged as failed.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
