    "homestays",
    "tourism",
    "fishery",
    "economy"
  ],
  "author": "Zek Furtado",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ZekFurtado/Samudrayan-Backend/issues"
  },
  "homepage": "https://github.com/ZekFurtado/Samudrayan-Backend#readme",
  "devDependencies": {
    "eslint": "^9.39.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2"
  }
}
