  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "lint": "eslint packages/**/src/**/*.js services/**/src/**/*.js",
    "lint:fix": "eslint packages/**/src/**/*.js services/**/src/**/*.js --fix",
    "format": "prettier --write packages/**/src/**/*.js services/**/src/**/*.js",
    "test": "echo \"Error: no test specified\" && exit 1"
